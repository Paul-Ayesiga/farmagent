# FA Payment Service Environment Variables Template

APP_ENV=development
APP_PORT=8004

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=farmagent
DB_PASSWORD=your-password
DB_NAME=farmagent_payments

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MTN MoMo Configuration
# Get these from https://momodeveloper.mtn.com
MTN_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=your-subscription-key
MTN_API_USER=your-api-user-uuid
MTN_API_KEY=your-api-key
MTN_CALLBACK_URL=http://your-callback-url.com/api/v1/payments/callback
