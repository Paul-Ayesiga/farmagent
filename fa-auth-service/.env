# Auth Service Environment
APP_NAME=fa-auth-service
APP_ENV=development
APP_PORT=8001

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=farmagent
DB_PASSWORD=farmagent_secret
DB_NAME=farmagent_auth

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Password Hashing (Argon2)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32
