# Notification Service Environment
APP_NAME=fa-notification-service
APP_ENV=development
APP_PORT=8003

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=farmagent_notifications

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Email (Mailpit for development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@farmagent.ug
SMTP_FROM_NAME=FarmAgent

# Africa's Talking (SMS)
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=FarmAgent

# Firebase (Push Notifications)
FCM_SERVER_KEY=your-fcm-server-key
